// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────────────────────────────────────────────────────
// Admin user
// ───────────────────────────────────────────────────────────────────────────
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  tokens       AccessToken[]
}

// ───────────────────────────────────────────────────────────────────────────
// Class/broadcast access tokens. SATU token bisa di-redeem oleh BANYAK siswa
// selama belum kadaluarsa — admin cukup share 1 link/kode ke grup kelas.
// Refresh di browser yang sama → tetap resume submission lama (lewat cookie).
// Browser baru / siswa lain → buat Submission baru untuk token yang sama.
// `redeemedAt` = waktu redeem pertama kali (informasi saja, tidak meng-lock).
// ───────────────────────────────────────────────────────────────────────────
model AccessToken {
  id          String      @id @default(cuid())
  code        String      @unique
  testKind    TestKind
  // Nama sekolah SESI TES — OPSIONAL, diisi admin saat membuat token. Pola
  // meniru token Tes IQ (CfitAccessToken.school), TAPI tabelnya tetap
  // terpisah penuh: token minat-bakat dan token CFIT tidak digabung.
  // Kalau diisi  → semua peserta token ini otomatis memakai tulisan sekolah
  //                yang sama persis (rekap & laporan jadi seragam).
  // Kalau kosong → perilaku LAMA tidak berubah sama sekali: siswa mengetik
  //                sendiri nama sekolah di form data diri.
  school      String?
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  createdById String?
  createdBy   AdminUser?  @relation(fields: [createdById], references: [id])
  redeemedAt  DateTime?
  submissions Submission[]

  @@index([testKind])
}

enum TestKind {
  MINAT
  BAKAT
}

// ───────────────────────────────────────────────────────────────────────────
// Subtest configuration. For Bakat: 9 subtests (Penalaran Visual, etc.)
// For Minat: 1 "Bidang Minat" subtest + 8 program subtests (A..H).
// ───────────────────────────────────────────────────────────────────────────
model Subtest {
  id           String             @id @default(cuid())
  code         String             @unique
  testKind     TestKind
  name         String
  description  String
  instructions String             @default("")
  durationSec  Int
  orderIndex   Int                @default(0)
  questions    Question[]
  progress     SubtestProgress[]
}

model Question {
  id            String          @id @default(cuid())
  subtestId     String
  subtest       Subtest         @relation(fields: [subtestId], references: [id], onDelete: Cascade)
  questionNo    Int
  prompt        String
  imageUrl      String?
  imageUrl2     String?
  parts         Int             @default(1)
  options       Json
  correct       Json
  // Per-question override untuk label nomor di tiap sel "lembar jawaban"
  // (mis. SPASIAL & SISTEMATIS). null = pakai default dari test-config
  // (1, 2, 3, …). Disimpan sebagai array string.
  partLabels    Json?
  scoringTag    String?
  isExample     Boolean         @default(false)
  inputMode     String          @default("CHOICE")
  createdAt     DateTime        @default(now())

  @@unique([subtestId, questionNo, isExample])
  answers       Answer[]
}

// ───────────────────────────────────────────────────────────────────────────
// Submission = a student attempt. Created when token is redeemed.
// ───────────────────────────────────────────────────────────────────────────
model Submission {
  id            String       @id @default(cuid())
  tokenId       String
  token         AccessToken  @relation(fields: [tokenId], references: [id])
  testKind      TestKind
  fullName      String?
  gender        String?
  // Jenjang pendidikan peserta: "SMP", "SMA", atau "SMK". Menentukan
  // bentuk rekomendasi di laporan PDF (lanjut sekolah / kuliah / kerja).
  jenjang       String?
  birthPlace    String?
  birthDate     DateTime?
  age           Int?
  grade         String?
  school        String?
  major         String?
  phone         String?
  email         String?
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
  randomSeed    String
  // "Kode Lanjut" — kode pemulihan sesi, format XXXX-XX. Dipakai siswa untuk
  // MELANJUTKAN submission yang sama lewat halaman /lanjut kalau cookie
  // hilang (mati lampu, komputer mereset profil browser, ganti komputer).
  // Tanpa ini, satu-satunya penanda sesi adalah cookie `tmb_student` — kalau
  // cookie hilang, sesi lama tidak bisa dijangkau lagi.
  resumeCode       String?   @unique
  violationCount   Int       @default(0)
  violationLog     Json      @default("[]")
  flaggedCheating  Boolean   @default(false)
  answers       Answer[]
  result        Result?
  subtestProgress SubtestProgress[]

  @@index([tokenId])
  @@index([finishedAt])
}

// Per-subtest lock state. Created when student first opens a subtest.
// finishedAt: kapan subtes terkunci (manual via tombol Selesai, atau auto
// karena timer habis). finishReason: "MANUAL" | "TIME_UP" | "AUTO_FLAG".
//
// TIMER SADAR-JEDA: timer TIDAK lagi memakai jam dinding
// (startedAt + durationSec), melainkan `consumedSec` — akumulasi waktu AKTIF
// siswa di halaman soal. Lihat src/lib/subtestLock.ts.
model SubtestProgress {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  subtestId    String
  subtest      Subtest    @relation(fields: [subtestId], references: [id], onDelete: Cascade)
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  finishReason String?
  // Waktu AKTIF yang sudah terpakai di subtes ini (detik). Ini yang dipakai
  // timer, bukan (now - startedAt). Subtes terkunci saat consumedSec >=
  // durationSec.
  consumedSec  Int        @default(0)
  // Denyut terakhir dari browser siswa (heartbeat / kirim jawaban / buka
  // halaman). Selisih now - lastSeenAt dipakai untuk membedakan "masih
  // mengerjakan" vs "terputus".
  lastSeenAt   DateTime?
  // Statistik jeda untuk pengawas: berapa kali sesi terputus, dan total
  // detik jeda yang DIMAAFKAN (maksimal PAUSE_BUDGET_SEC = 600 detik).
  pauseCount   Int        @default(0)
  pausedSec    Int        @default(0)

  @@unique([submissionId, subtestId])
  @@index([submissionId])
}

model Answer {
  id            String      @id @default(cuid())
  submissionId  String
  submission    Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selected      Json
  partialScore  Float       @default(0)
  isCorrect     Boolean     @default(false)
  answeredAt    DateTime    @default(now())

  @@unique([submissionId, questionId])
}

// ───────────────────────────────────────────────────────────────────────────
// Final aggregated result (computed at finalize).
// ───────────────────────────────────────────────────────────────────────────
model Result {
  id              String      @id @default(cuid())
  submissionId    String      @unique
  submission      Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  payload         Json
  iqEstimate      Int?
  topProfiles     Json?
  topPrograms     Json?
  generatedAt     DateTime    @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════
// CFIT SKALA 3 (BENTUK A & B) — TES IQ
// Sengaja TERPISAH PENUH dari tabel minat-bakat di atas: bank soal, token,
// submission, jawaban, dan hasil punya tabel sendiri (prefix `Cfit`).
// Tidak ada relasi ke Subtest/Question/Submission/Result minat-bakat.
// `createdById` di CfitAccessToken sengaja TANPA relasi Prisma ke AdminUser
// agar model minat-bakat tidak perlu disentuh sama sekali.
// ═══════════════════════════════════════════════════════════════════════════

enum CfitForm {
  FORM_3A // hanya bentuk A (RS maks ± 50)
  FORM_3B // hanya bentuk B
  FORM_3AB // gabungan A + B (standar administrasi penuh)
}

// Token akses khusus CFIT — terpisah dari AccessToken minat-bakat.
// Pola sama: satu kode bisa dipakai banyak peserta selama belum kadaluarsa.
model CfitAccessToken {
  id          String    @id @default(cuid())
  code        String    @unique
  form        CfitForm  @default(FORM_3AB)
  // Sekolah & kelas SESI TES, diisi admin saat membuat token. Semua peserta
  // yang memakai token ini otomatis memakai tulisan yang sama persis, jadi
  // filter rekap dan identitas di laporan PDF tidak lagi bergantung pada
  // ketikan bebas siswa (mis. "SMKN 1" vs "SMK Negeri 1").
  school      String?
  grade       String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  createdById String? // id AdminUser (tanpa FK, biar tabel lama tak tersentuh)
  redeemedAt  DateTime?
  submissions CfitSubmission[]

  @@index([form])
}

// 4 subtes per bentuk: Series, Classification, Matrices, Conditions.
model CfitSubtest {
  id           String  @id @default(cuid())
  code         String  @unique // mis. "3A_SERIES"
  form         CfitForm
  name         String
  description  String  @default("")
  instructions String  @default("")
  durationSec  Int
  orderIndex   Int     @default(0)
  questions    CfitQuestion[]
  progress     CfitSubtestProgress[]
}

// Bank soal CFIT — soal berbentuk gambar (imageUrl), opsi a-f.
model CfitQuestion {
  id         String      @id @default(cuid())
  subtestId  String
  subtest    CfitSubtest @relation(fields: [subtestId], references: [id], onDelete: Cascade)
  questionNo Int
  prompt     String      @default("")
  imageUrl   String?
  options    Json // mis. ["a","b","c","d","e","f"]
  correct    Json // kunci jawaban; Conditions bisa >1 jawaban benar
  isExample  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  answers    CfitAnswer[]

  @@unique([subtestId, questionNo, isExample])
}

model CfitSubmission {
  id              String          @id @default(cuid())
  tokenId         String
  token           CfitAccessToken @relation(fields: [tokenId], references: [id])
  form            CfitForm
  fullName        String?
  // Nomor Induk Siswa peserta — dicetak di identitas laporan, di bawah nama.
  nis             String?
  gender          String?
  birthPlace      String?
  birthDate       DateTime?
  age             Int? // norma tabel saat ini: usia 17 th ke atas
  grade           String?
  school          String?
  phone           String?
  email           String?
  startedAt       DateTime        @default(now())
  finishedAt      DateTime?
  randomSeed      String          @default("")
  violationCount  Int             @default(0)
  violationLog    Json            @default("[]")
  flaggedCheating Boolean         @default(false)
  answers         CfitAnswer[]
  result          CfitResult?
  subtestProgress CfitSubtestProgress[]

  @@index([tokenId])
  @@index([finishedAt])
}

// Lock per-subtes (server-authoritative timer), pola sama dgn SubtestProgress.
model CfitSubtestProgress {
  id           String         @id @default(cuid())
  submissionId String
  submission   CfitSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  subtestId    String
  subtest      CfitSubtest    @relation(fields: [subtestId], references: [id], onDelete: Cascade)
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?
  finishReason String? // "MANUAL" | "TIME_UP" | "AUTO_FLAG"

  @@unique([submissionId, subtestId])
  @@index([submissionId])
}

model CfitAnswer {
  id           String         @id @default(cuid())
  submissionId String
  submission   CfitSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     CfitQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selected     Json
  isCorrect    Boolean        @default(false)
  answeredAt   DateTime       @default(now())

  @@unique([submissionId, questionId])
}

// Hasil final CFIT: RS per bentuk, RS total, IQ hasil konversi norma,
// dan klasifikasi (mis. "Rata-rata", "Superior").
model CfitResult {
  id             String         @id @default(cuid())
  submissionId   String         @unique
  submission     CfitSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  rawScoreA      Int?
  rawScoreB      Int?
  rawScoreTotal  Int
  iq             Int
  classification String
  payload        Json? // rincian per subtes, dsb.
  generatedAt    DateTime       @default(now())
}

// Tabel norma konversi RS → IQ. `normGroup` menyiapkan kemungkinan norma
// kelompok usia lain di masa depan; saat ini terisi "17+".
model CfitNorm {
  id        String @id @default(cuid())
  normGroup String @default("17+")
  rawScore  Int
  iq        Int

  @@unique([normGroup, rawScore])
}
